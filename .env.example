# Environment variables for Voce. Copy to .env.local (ignored by git) and fill in the values.
# Uncommented lines are required in production (Vercel); commented ones are optional.
# Never put real values in this file.

# Supabase. Locally: `supabase status -o env` (API_URL, PUBLISHABLE_KEY, SECRET_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: public form, AI analysis bookkeeping, Stripe webhook, tests.
SUPABASE_SECRET_KEY=

# Stripe, test mode. Without all three, payments are off and every workspace keeps its plan.
# Prefer a restricted key (rk_test_...).
STRIPE_SECRET_KEY=
# whsec_...: from `stripe listen` locally, from the dashboard endpoint on Vercel.
STRIPE_WEBHOOK_SECRET=
# price_...: the Pro price, 19 EUR per month.
STRIPE_PRICE_ID=

# PostHog EU project API key (phc_...), server only. Without it no event is sent.
POSTHOG_KEY=

# AI analysis through Vercel AI Gateway. On Vercel the OIDC token is automatic.
# Locally: `vercel env pull` (VERCEL_OIDC_TOKEN, lasts 12 hours) or an API key.
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=
# Default: anthropic/claude-sonnet-5.
# AI_MODEL=
# Only for the end-to-end test, which points it at a fake gateway (e2e/fake-gateway.mts).
# AI_GATEWAY_BASE_URL=
